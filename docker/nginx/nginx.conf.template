events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging: both destinations are the container's standard streams so an
    # operator reads them through ``docker compose logs nginx``. Logs written to
    # a file under /var/log/nginx would land on the tmpfs mount and never reach
    # ``docker logs`` -- they would vanish with the container.
    #
    # The access format intentionally logs ``$uri`` (the path only) and never
    # ``$request_uri`` (path plus query string): a request line carrying a
    # ``filters=`` payload would otherwise write user-supplied filter values
    # into the access log. ``$uri`` is a single-quoted-ish literal here in the
    # sense that envsubst must not eat it -- see the entrypoint render script,
    # which substitutes only ${NGINX_CLIENT_MAX_BODY_SIZE}, so nginx's own $uri
    # reaches the runtime verbatim.
    log_format mkobi_redacted '$remote_addr - $remote_user [$time_local] '
                              '"$request_method $uri $server_protocol" '
                              '$status $body_bytes_sent "$http_referer" '
                              '"$http_user_agent"';
    access_log /dev/stdout mkobi_redacted;
    error_log /dev/stderr;

    server {
        listen [::]:80;
        server_name localhost;

        # Upload byte ceiling for the edge.
        # The application is authoritative: it enforces UPLOAD__MAX_FILE_SIZE_MB
        # while streaming the request body and totals the reader boundary, so the
        # application decides whether an upload is accepted. The edge value exists
        # only to stop a grossly oversized body before it is proxied, and defaults
        # deliberately above the application ceiling so the two never disagree at
        # the boundary. If they do disagree, the application is right: a body the
        # application would reject is normal, not an error, while a body the edge
        # rejects first never reaches the application at all.
        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # NOTE: HSTS header should only be set on HTTPS connections.
        # See the commented HTTPS server block below for proper HSTS configuration.
        # Content Security Policy
        # Note: React SPA uses external scripts only (no inline scripts), so 'self' directive is sufficient.
        # Nonce-based CSP is not required as there are no inline <script> tags.
        # style-src allows 'unsafe-inline' for React CSS-in-JS styling patterns.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

        # /api prefix is intentional -- matches FastAPI router prefix /api/v1/*
        # Requests to /api/v1/* are forwarded to the app container as-is
        location /api {
            proxy_pass http://app:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # /health is unauthenticated; /health/detailed is admin-gated at the
        # application layer (unsatisfied callers get 401/403 through this proxy).
        location ~ ^/health(/detailed)?$ {
            proxy_pass http://app:8000;
            proxy_set_header Host $host;
        }

        # Static files -> React build
        location / {
            root /usr/share/nginx/html;
            rewrite ^/(.*)/$ /$1 permanent;
            try_files $uri $uri/ /index.html;
        }
    }

    # HTTPS server block template (uncomment and configure for production TLS):
    # server {
    #     listen 443 ssl;
    #     server_name _;
    #
    #     ssl_certificate /etc/nginx/ssl/cert.pem;
    #     ssl_certificate_key /etc/nginx/ssl/key.pem;
    #
    #     # HSTS header (only meaningful over HTTPS)
    #     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    #     # Upload byte ceiling for the edge -- see the HTTP block above; the
    #     # application is authoritative.
    #     client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    #     add_header X-Content-Type-Options "nosniff" always;
    #     add_header X-Frame-Options "SAMEORIGIN" always;
    #     add_header X-XSS-Protection "1; mode=block" always;
    #     add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    #     add_header Content-Security-Policy "default-src 'self'" always;
    #
    #     location /api {
    #         proxy_pass http://app:8000;
    #         proxy_set_header Host $host;
    #         proxy_set_header X-Real-IP $remote_addr;
    #         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #         proxy_set_header X-Forwarded-Proto $scheme;
    #     }
    #
    #     # Health check endpoints (no auth required) - matches /health and /health/detailed
    #     location ~ ^/health(/detailed)?$ {
    #         proxy_pass http://app:8000;
    #         proxy_set_header Host $host;
    #     }
    #
    #     location / {
    #         root /usr/share/nginx/html;
    #         rewrite ^/(.*)/$ /$1 permanent;
    #         try_files $uri $uri/ /index.html;
    #     }
