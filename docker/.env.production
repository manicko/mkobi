# Production Environment Variables for mkobi BI Dashboard System
# REQUIRED: Copy this file to docker/.env.production and fill in all values before deployment
# WARNING: Never commit actual production secrets to version control!
# Usage: docker compose --env-file docker/.env.production -f docker/docker-compose.yml up -d

# NOTE: The compose file pins ENV to production. This name is no longer read.
# ENV=production

# Required secrets (MUST be set for production deployment)
# DATABASE__PASSWORD: Database password for postgres superuser
# MKOBI_APP_PASSWORD: Application role password for runtime operations
# JWT__SECRET_KEY: Strong secret key (use: openssl rand -hex 32)
# ADMIN_USERNAME: Initial admin username
# ADMIN_PASSWORD: Initial admin password

# Database settings
# NOTE: The compose file hard-codes DATABASE__HOST, DATABASE__PORT and
# DATABASE__DBNAME for every service that has them, so those values win here.
# DATABASE__HOST=db
# DATABASE__PORT=5432
# DATABASE__DBNAME=bidb

# JWT settings
# NOTE: The compose file hard-codes JWT__ALGORITHM, so that value wins here.
# JWT__ALGORITHM=HS256

# CORS - origins allowed to access the API (JSON array format)
# NOTE: The value shipped here was the placeholder https://your-domain.com, so
# the production tier refused startup with "Placeholder CORS origins not allowed
# in production". The compose file supplies a default for CORS_ORIGINS and that
# default is a placeholder too, so a production operator must set this name
# explicitly to real domains, for example:
# CORS_ORIGINS='["https://app.example.org"]'

# Logging
LOGGING__LEVEL=WARNING
LOGGING__JSON_LOGGING=true

# Upload settings
# NOTE: The compose file hard-codes UPLOAD__TEMP_DIR, so that value wins here.
# UPLOAD__TEMP_DIR=/app/data/tmp_uploads
UPLOAD__MAX_FILE_SIZE_MB=100
# NOTE: No compose service supplies UPLOAD__ALLOWED_EXTENSIONS; the application
# default (src/mkobi/settings/app.yaml) applies. That default drives
# Settings.allowed_file_types -> upload.allowed_extensions, which validate_file
# reads, so an operator who needs to widen the accepted extensions sets this
# name explicitly.
# UPLOAD__ALLOWED_EXTENSIONS='["csv.gz", "csv"]'

# Rate limiter - fail-closed for security
RATE_LIMITER_FAIL_CLOSED=true