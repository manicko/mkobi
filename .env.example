# Environment Variables for mkobi BI Dashboard System
# Copy this file to .env and fill in your values
# WARNING: Change these credentials for production use!

# Note: Docker Compose reads .env automatically. For production deployments:
# - Use docker/.env.production template
# - Run: docker compose --env-file docker/.env.production -f docker/docker-compose.yml up -d

# Environment: development, staging, production, test
ENV=development

# Database settings (use __ for nested)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
# Generate with: openssl rand -hex 32
DATABASE__PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET
DATABASE__DBNAME=bidb

# Admin credentials for test database creation
DATABASE__ADMIN_USER=postgres
# Generate with: openssl rand -hex 32
DATABASE__ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT settings
# Generate with: openssl rand -hex 32
JWT__SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15

# Upload settings
UPLOAD__TEMP_DIR=data/tmp_uploads
UPLOAD__MAX_FILE_SIZE_MB=100
UPLOAD__ALLOWED_EXTENSIONS='["csv.gz", "csv"]'
UPLOAD__ALLOWED_MIME_TYPES='["text/csv", "application/gzip"]'

# Redis settings (optional, for task queue)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# App settings
APP_NAME=mkobi
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Host-published Docker ports (configurable to run checkouts in parallel).
# Container-internal ports are never changed; these override only the host side.
# Dev app host port (container 8000):
APP_HOST_PORT=8010
# Test stack host ports (container ports 5432 / 6379 / 8000):
TEST_DB_HOST_PORT=5434
TEST_REDIS_HOST_PORT=6381
TEST_APP_HOST_PORT=8001

# Logging
LOGGING__LEVEL=INFO
LOGGING__JSON_LOGGING=true

# CORS - origins allowed to access the API (JSON array format)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Admin credentials
# Use strong credentials in production
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Application role password for runtime operations
MKOBI_APP_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET

# Database migrations - handled by migrate service, not by app runtime
AUTO_MIGRATE=false
MIGRATION_SCRIPT_PATH=alembic
ALEMBIC_INI_PATH=alembic.ini
RECREATE_TEST_DB=true